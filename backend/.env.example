# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (the Vite dev server uses 5173).
FRONTEND_URL=http://localhost:5173
# Set to 1 when running behind a reverse proxy (Render, Vercel, Nginx) so rate limiting sees real client IPs.
TRUST_PROXY=0

# ---- Supabase (server-side only; never expose the service role key to the browser) ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# ---- Authentication ----
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# ---- First administrator (created on first start if missing; used from phase 3) ----
ADMIN_NAME=RetailTrack Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ---- OTP / email (optional; needed only for email verification and password reset) ----
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=RetailTrack
SMTP_FROM_EMAIL=

# ---- Product images (optional) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
